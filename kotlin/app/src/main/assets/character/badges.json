{
  "version": "v1",
  "note": "배지 5종 해금 조건(#69, E5-8) + 글리프 슬롯(#266). BadgeEvaluator가 when(불리언 식)을 평가해 참이면 해금. 조건 수정·배지 추가 = JSON만(코드 무수정). icon은 drawable badge_<icon> 접미사(BadgeAssetConvention) — 생략하면 기본 글리프. 정식 아트(#76)는 같은 슬롯에 코드 무수정 드롭인. 임계값은 밸런스 튜닝 대상(#77 라운드).",
  "badges": [
    {
      "id": "first_step",
      "icon": "first_step",
      "name": "첫걸음",
      "description": "함께한 첫 활동을 기록했어요.",
      "when": "activeDaysTotal >= 1"
    },
    {
      "id": "week_streak",
      "icon": "streak",
      "name": "꾸준함의 증표",
      "description": "7일 연속 함께 움직였어요.",
      "when": "streakDays >= 7"
    },
    {
      "id": "level_10",
      "icon": "level",
      "name": "성장의 궤도",
      "description": "레벨 10에 도달했어요.",
      "when": "level >= 10"
    },
    {
      "id": "first_expedition",
      "icon": "expedition",
      "name": "탐험가",
      "description": "첫 원정을 완료했어요.",
      "when": "expeditionsCompleted >= 1"
    },
    {
      "id": "ten_thousand",
      "icon": "steps",
      "name": "만보 주파",
      "description": "하루 10,000보를 넘겼어요.",
      "when": "bestDaySteps >= 10000"
    },
    {
      "id": "sleep_streak_3",
      "icon": "sleep",
      "name": "잘 자는 습관",
      "description": "3일 연속 수면을 기록했어요.",
      "when": "sleepStreakDays >= 3"
    },
    {
      "id": "sleep_streak_7",
      "icon": "sleep",
      "name": "꿈나라 단골",
      "description": "7일 연속 수면을 기록했어요.",
      "when": "sleepStreakDays >= 7"
    }
  ]
}
